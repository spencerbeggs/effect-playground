{
	"name": "@effected/package",
	"version": "0.0.0",
	"private": true,
	"description": "Scratchpad for building, versioning and publishing Effected packages.",
	"keywords": ["effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/package#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/package"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected"
	},
	"peerDependencies": {
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
